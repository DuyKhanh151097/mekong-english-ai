# Cơ sở dữ liệu (mặc định SQLite cho phát triển; production đổi provider sang postgresql trong prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Khoá bí mật ký phiên đăng nhập (đổi thành chuỗi ngẫu nhiên dài khi triển khai)
AUTH_SECRET="change-me-to-a-long-random-string"

# (Tuỳ chọn) Khoá Gemini API để gia sư AI phản hồi thông minh hơn. Bỏ trống => dùng bộ chấm quy tắc nội bộ.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Thông tin nhận chuyển khoản VietQR (demo)
VIETQR_BANK="VCB"
VIETQR_ACCOUNT="0123456789"
VIETQR_ACCOUNT_NAME="CONG TY TNHH CONG NGHE MEKONG GREEN AI"
